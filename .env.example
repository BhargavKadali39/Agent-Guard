# Copy to .env (next to docker-compose.yml) and adjust. Never commit .env.
# Everything works with the defaults below; no API keys are needed in mock mode.

# --- Database (docker-compose) ------------------------------------------------
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=agentguard

# --- Auth ----------------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty to get a random secret per start-up (users must sign in again after a restart).
JWT_SECRET=
# Shared password for the four fictional demo users (local development only).
DEMO_USER_PASSWORD=agentguard-demo

# --- AI provider ----------------------------------------------------------------
# mock (default, offline, deterministic) | anthropic | openai_compatible
AI_PROVIDER=mock
# The mock can simulate a model that obeys injected instructions ("comply") so the
# backend defenses are visible, or one that ignores them ("resist").
MOCK_INJECTION_BEHAVIOR=comply
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works (e.g. Groq, OpenRouter, a local Ollama server).
OPENAI_BASE_URL=https://api.openai.com/v1
