# Local (non-Docker) backend settings. Copy to backend/.env and adjust.
ENVIRONMENT=development
# SQLite needs no setup. For PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg://agentguard:agentguard@localhost:5432/agentguard
DATABASE_URL=sqlite:///./agentguard.db
JWT_SECRET=
DEMO_USER_PASSWORD=agentguard-demo
LOG_FORMAT=console
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
AI_PROVIDER=mock
MOCK_INJECTION_BEHAVIOR=comply
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
